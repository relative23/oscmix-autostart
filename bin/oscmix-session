#!/usr/bin/env python3
"""oscmix-session -- supervise the oscmix backend for an RME Fireface interface.

This program is the ExecStart of the oscmix systemd user service. It

  1. waits until the Fireface registers as an ALSA sequencer client,
  2. starts ``alsaseqio <client>:1 oscmix`` (the MIDI <-> OSC bridge),
  3. waits until oscmix listens on its OSC UDP port,
  4. applies the mixer routing configured in routing.conf, and
  5. supervises the backend until it exits or the service is stopped.

Exit codes are chosen so systemd restarts the service only when a restart
can actually help:

  0  nothing to do (device not connected), clean shutdown, or backend
     exited cleanly
  1  runtime failure (systemd restarts via Restart=on-failure)
  2  configuration error (no restart; see RestartPreventExitStatus)

The logic lives in the ``oscmix_autostart`` package next to this file;
this is only the entry point. Only the Python standard library is used,
so both halves run from a checkout on a bare system.
"""

import sys
from pathlib import Path


def _package_root() -> Path:
    """Locate the directory holding ``oscmix_autostart``.

    Two layouts have to work with no install step in between: a git
    checkout (``<repo>/bin`` next to ``<repo>/src``) and the installed
    tree (``~/.local/bin`` next to ``~/.local/lib/oscmix-autostart``).
    """
    here = Path(__file__).resolve().parent
    for candidate in (here.parent / "src",
                      here.parent / "lib" / "oscmix-autostart"):
        if (candidate / "oscmix_autostart" / "__init__.py").is_file():
            return candidate
    raise SystemExit(
        "oscmix-session: cannot find the oscmix_autostart package near %s "
        "-- run install.sh, or start it from a checkout" % here
    )


sys.path.insert(0, str(_package_root()))

from oscmix_autostart.cli import main  # noqa: E402  (needs the path above)

if __name__ == "__main__":
    sys.exit(main())
